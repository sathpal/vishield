# Grafana Cloud credentials for shipping metrics. Copy to observability/.env (git-ignored).
# Portal -> stack -> "Send data" -> OpenTelemetry (OTLP)
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=<numeric stack id>
# Cloud Access Policy token with metrics:write
GRAFANA_CLOUD_API_TOKEN=glc_xxx

# Grafana HTTP API for pushing the dashboard (scripts/push_grafana_dashboard.py)
GRAFANA_URL=https://<stack>.grafana.net
# Service account token with Editor role
GRAFANA_SA_TOKEN=glsa_xxx
# Prometheus data source uid in that stack (Connections -> Data sources)
GRAFANA_PROM_DS_UID=grafanacloud-prom

# Scrape target as seen from the Alloy container
VISHIELD_METRICS_TARGET=host.docker.internal:8000
VISHIELD_INSTANCE_NAME=laptop
VISHIELD_ENV_NAME=dev
