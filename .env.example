# Copy to .env and adjust. Never commit .env.
# All variables are optional; defaults are safe for a student laptop.

VISHIELD_ENV=development
VISHIELD_LOG_LEVEL=INFO

# Upload limits
VISHIELD_MAX_FILE_MB=10
VISHIELD_MAX_DURATION_SECONDS=180
VISHIELD_MIN_DURATION_SECONDS=1

# Speech-to-text: "mock" (no model download) or "whisper" (requires `pip install .[stt]`)
VISHIELD_STT_BACKEND=mock
VISHIELD_WHISPER_MODEL_SIZE=base
VISHIELD_WHISPER_COMPUTE_TYPE=int8

# Risk engine weights (renormalised at runtime over the components that are available)
VISHIELD_WEIGHT_RULES=0.4
VISHIELD_WEIGHT_ML=0.5
VISHIELD_WEIGHT_ACOUSTIC=0.1
VISHIELD_RISK_MEDIUM_THRESHOLD=35
VISHIELD_RISK_HIGH_THRESHOLD=65

# Experimental synthetic-voice signal (off by default)
VISHIELD_ENABLE_SYNTHETIC_VOICE_SIGNAL=false

# Persistence
VISHIELD_DATABASE_URL=sqlite:///./vishield.db
VISHIELD_MODEL_PATH=models/tfidf_logreg.joblib

# DEVELOPMENT ONLY. Storing raw audio is disabled by default and must never be enabled
# for recordings of real people without written consent.
VISHIELD_DEV_STORE_AUDIO=false
VISHIELD_DEV_AUDIO_DIR=data/dev_audio

# Dashboard -> API
VISHIELD_API_BASE_URL=http://localhost:8000
